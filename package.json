{
  "name": "india-critical-minerals",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "India Critical Minerals: scores, projects and capabilities in one site (Takshashila Institution).",
  "scripts": {
    "data": "node scripts/build-data.mjs",
    "dev": "vite --port 5190 --strictPort --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 5191 --strictPort --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "check": "node scripts/check.mjs",
    "visit": "NODE_PATH=../_work/tools/node_modules node scripts/visit-all.cjs"
  },
  "dependencies": {
    "@fontsource-variable/hanken-grotesk": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@fontsource/space-mono": "^5.3.0",
    "d3": "^7.9.2",
    "d3-sankey": "^0.12.3",
    "fuse.js": "^7.5.0",
    "maplibre-gl": "^6.17.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/d3": "^7.4.3",
    "@types/d3-sankey": "^0.12.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
